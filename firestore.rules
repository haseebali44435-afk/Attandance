rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        !userExists() || (getUserData().keys().hasAll(['role']) && getUserData().role == 'ADMIN')
      );
    }

    function isTeacher() {
      return isAuthenticated() && userExists() && getUserData().keys().hasAll(['role']) && getUserData().role == 'TEACHER';
    }

    function isStudent() {
      return isAuthenticated() && userExists() && getUserData().keys().hasAll(['role']) && getUserData().role == 'STUDENT';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Departments Collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Semesters Collection
    match /semesters/{semId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Subjects Collection
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Teacher Assignments Collection
    match /teacherAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Attendance Sessions Collection
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();

      // Authenticated teachers can create attendance sessions
      allow create: if isAuthenticated();

      // Teachers can edit session only ONCE (editCount < 1)
      allow update: if isAuthenticated()
        && resource.data.teacherId == request.auth.uid
        && resource.data.editCount < 1
        && request.resource.data.editCount == resource.data.editCount + 1;

      allow delete: if false;
    }
  }
}