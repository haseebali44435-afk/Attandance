<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditAttendance"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Edit Session Attendance"
        app:titleTextColor="@color/white" />

    <!-- Audit Warning Banner -->
    <LinearLayout
        android:id="@+id/layoutWarningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarEditAttendance"
        android:background="@color/warning_orange_light"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Warning"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/warning_orange" />

        <TextView
            android:id="@+id/tvEditWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Important: Policy permits only 1-time post-submission editing. Changes are logged."
            android:textColor="@color/warning_orange"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEditStudents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomUpdate"
        android:layout_below="@id/layoutWarningBanner"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Sticky Update Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_light"
        android:elevation="8dp"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateAttendance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Attendance Correction"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</RelativeLayout>